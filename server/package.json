{
  "name": "@paramin-karsiligi/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "snapshot": "tsx --env-file-if-exists=.env src/snapshot.ts",
    "evds": "tsx --env-file-if-exists=.env src/evdsExplore.ts"
  },
  "dependencies": {
    "@paramin-karsiligi/shared": "*",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.2",
    "vitest": "^5.0.5"
  }
}
